{
  "name": "ramah-phishguard",
  "version": "1.0.0",
  "private": true,
  "description": "Cybersecurity and phishing detection platform by RAMAH TECHNOLOGIES",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
